# Секреты
.env
.env.*
!.env.example

# Данные о детях никогда не попадают в git: сырые ответы VK, база, скачанные
# фото. Настоящие данные лежат в $DOBROMIR_DATA вне репозитория; эти строки -
# страховка, если каталог данных по ошибке задали внутри него.
data/
*.sqlite
*.sqlite3
*.db

# Рабочие файлы агента (заметки, черновики коммитов)
tmp/

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Исходники фото содержимого (JPEG, PNG с телефона) - с геометками и моделью телефона.
# Сборка (site/scripts/prepare-content.ts) делает из них WebP без метаданных; в git
# попадает только он.
site/content/**/photos/*
!site/content/**/photos/*.webp

# Node / Astro
node_modules/
dist/
.astro/

# Редакторы и ОС
.idea/
.vscode/
*~
*.swp
.DS_Store

# Локальные настройки агентов. AGENTS.md и указатель CLAUDE.md в git нарочно,
# все остальное, что создает локальная установка, - нет.
.claude/
.opencode/
.cursor/
.mcp.json
