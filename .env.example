# Шаблон переменных воркера. Только заглушки, настоящих ключей здесь нет и быть не должно.
# Настоящие значения - в ~/dobromir-data/.env (права 600), одинаково на ноутбуке и на
# сервере; переменные окружения процесса сильнее файла. Других файлов код не читает.
# Код чтения - pipeline/src/pipeline/settings.py.

# --- Обязательные ---

# Непубличный каталог воркера: база, экспорт, логи, status.json и этот .env. По умолчанию
# ~/dobromir-data; задавать только в окружении процесса и только если каталог лежит
# в другом месте - строка внутри самого .env каталог не меняет.
# DOBROMIR_DATA=

# Папка сайта Beget: media/, releases/, ссылка public_html. Абсолютный путь.
# На сервере: /home/a/a978879k/a978879k.beget.tech
SITE_ROOT=

# production или staging, без значения по умолчанию: staging добавляет noindex.
SITE_ENV=

# --- VK (нужны воркеру) ---

# Сервисный ключ приложения VK: только он читает стену (wall.get, wall.getById).
VK_SERVICE_TOKEN=
# Ключ сообщества: стену не читает (ошибка 27, проверено 2026-10-22). Воркеру не нужен
# (решение О2 от 2026-10-23), на сервере оставить пустым.
VK_COMMUNITY_TOKEN=
# id группы без минуса. Тестовая группа antarctic.test - 242263522.
VK_GROUP_ID=

# --- Необязательные (в комментарии - значение по умолчанию) ---

# VK_API_URL=https://api.vk.ru/method/
# VK_WINDOW=50
# VK_PAGE_SIZE=100
# VK_BY_ID_BATCH=100
# MAX_BUILDS_PER_DAY=4
# Сколько дней новость живет на сайте и в базе; старше - удаляется вместе с фото.
# NEWS_RETENTION_DAYS=30
# RECONCILE_AFTER_HOUR=3
# TZ_NAME=Europe/Simferopol
# SITE_URL=https://xn----9sbirljdkbtdc7l.xn--p1ai
# Подтверждение прав в Яндекс.Вебмастере и Google Search Console (мета-тег); пусто - нет тега.
# YANDEX_VERIFICATION=
# GOOGLE_VERIFICATION=
# BUILD_TIMEOUT=600   (секунд на сборку сайта)
# NODE_BIN - по умолчанию ~/opt/node/bin; если задавать, то полным путем:
# $HOME и ~ здесь не раскрываются.
# NODE_BIN=/home/a/a978879k/opt/node/bin
