# Шаблон переменных воркера. Только заглушки, настоящих ключей здесь нет и быть не должно.
# Где лежат настоящие значения (каждый следующий источник сильнее):
#   ~/.env.local             - на ноутбуке;
#   <DOBROMIR_DATA>/.env     - на сервере (~/dobromir-data/.env);
#   окружение процесса.
# Код чтения - pipeline/src/pipeline/settings.py.

# --- Обязательные ---

# Непубличный каталог воркера: база, экспорт, логи, status.json. Абсолютный путь вне
# репозитория. На сервере: /home/a/a978879k/dobromir-data
DOBROMIR_DATA=

# Папка сайта Beget: media/, releases/, ссылка public_html. Абсолютный путь.
# На сервере: /home/a/a978879k/a978879k.beget.tech
SITE_ROOT=

# production или staging, без значения по умолчанию: staging добавляет noindex.
SITE_ENV=

# --- VK (нужны воркеру) ---

# Сервисный ключ приложения VK: им читается стена.
VK_SERVICE_TOKEN=
# Ключ сообщества: запасной, только если проверка P1-1 покажет, что он читает стену.
VK_COMMUNITY_TOKEN=
# id группы без минуса. Тестовая группа antarctic.test - 242263522.
VK_GROUP_ID=

# --- Необязательные (в комментарии - значение по умолчанию) ---

# VK_API_URL=https://api.vk.ru/method/
# VK_WINDOW=50
# VK_PAGE_SIZE=100
# VK_BY_ID_BATCH=100
# MAX_BUILDS_PER_DAY=4
# RECONCILE_AFTER_HOUR=3
# TZ_NAME=Europe/Simferopol
# SITE_URL=https://xn----9sbirljdkbtdc7l.xn--p1ai
# NODE_BIN - по умолчанию ~/opt/node/bin; если задавать, то полным путем:
# $HOME и ~ здесь не раскрываются.
# NODE_BIN=/home/a/a978879k/opt/node/bin
