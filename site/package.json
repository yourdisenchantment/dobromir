{
    "name": "dobromir-site",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "node scripts/prepare-content.ts && astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "content:check": "node scripts/prepare-content.ts --check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "test": "node --test \"src/**/*.test.ts\""
    },
    "dependencies": {
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "^7.4.1",
        "sharp": "^0.35.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.11",
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/parser": "^8.72.0",
        "eslint": "^10.13.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
