---
// Страница специалиста. Ее же часть (SpecialistArticle, data-modal-content) показывает
// всплывающее окно на лендинге; по прямой ссылке и без JS открывается эта страница.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SpecialistArticle from "../../components/SpecialistArticle.astro";
import { loadSpecialists, type Specialist } from "../../lib/content";
import { siteUrl, withBase } from "../../lib/env";

export function getStaticPaths() {
    return loadSpecialists().items.map((person) => ({
        params: { slug: person.slug },
        props: { person },
    }));
}

interface Props {
    person: Specialist;
}

const { person } = Astro.props;
const description = person.short
    ? `${person.position}: ${person.short.toLowerCase()}. Центр «Добромир», Симферополь.`
    : `${person.position}, центр «Добромир», Симферополь.`;
const ogImage = new URL(person.image.src, `${siteUrl()}/`).href;

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "Person",
        name: person.name,
        jobTitle: person.position,
        description: person.short || person.description.join(" "),
        worksFor: {
            "@type": "Organization",
            name: "Республиканский центр коррекционной педагогики «Добромир»",
            url: new URL(withBase("/"), `${siteUrl()}/`).href,
        },
        url: new URL(withBase(`/specialisty/${person.slug}/`), `${siteUrl()}/`)
            .href,
        image: ogImage,
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Главная",
                item: new URL(withBase("/"), `${siteUrl()}/`).href,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "Специалисты",
                item: new URL(withBase("/#specialists"), `${siteUrl()}/`).href,
            },
            { "@type": "ListItem", position: 3, name: person.name },
        ],
    },
];
---

<Base
    title={person.name}
    description={description}
    ogImage={ogImage}
    jsonLd={jsonLd}
>
    <div class="container page">
        <Breadcrumbs
            items={[
                { href: withBase("/"), label: "Главная" },
                { href: withBase("/#specialists"), label: "Специалисты" },
            ]}
        />
        <SpecialistArticle person={person} />
    </div>
</Base>

<style>
    .page {
        max-width: 48rem;
        padding-block: var(--space-6) var(--space-7);
    }
</style>
