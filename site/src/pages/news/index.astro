---
// Архив новостей: все новости за срок хранения (NEWS_RETENTION_DAYS, решено 2026-10-26),
// новые первыми, закрепленный - наверху. Карточка открывается во всплывающем окне.
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { loadNews, newsCard } from "../../lib/news";

const posts = loadNews();
const ordered = [
    ...posts.filter((p) => p.pinned),
    ...posts.filter((p) => !p.pinned),
];
---

<Base
    title="Новости"
    description="Новости центра «Добромир»: занятия, события, объявления."
>
    <div class="container page">
        <h1>Новости</h1>
        <p class="lead">
            Новости центра за последний месяц. Все новости - в группе ВКонтакте.
        </p>
        {ordered.length === 0 ? (
            <p>Новостей пока нет.</p>
        ) : (
            <ul class="masonry">
                {ordered.map((post) => (
                    <Card as="li" {...newsCard(post)} />
                ))}
            </ul>
        )}
        <p>
            <a href="https://vk.com/dobromir.crimea" rel="noopener">
                Группа «Добромира» ВКонтакте
            </a>
        </p>
    </div>
</Base>

<style>
    .page {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        padding-block: var(--space-7);
    }
    .lead {
        font-size: var(--text-lead);
        color: var(--color-text-muted);
    }
</style>
