---
// Страница новости. Удаленного поста в news.json нет - страница не собирается, адрес дает 404.
// Ее же часть (PostArticle, data-modal-content) показывает всплывающее окно на лендинге.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostArticle from "../../components/PostArticle.astro";
import { clip } from "../../lib/cardtext";
import {
    displayTitle,
    loadNews,
    mediaUrl,
    summary,
    type NewsPost,
} from "../../lib/news";
import { siteUrl } from "../../lib/env";

export function getStaticPaths() {
    return loadNews().map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: NewsPost;
}

const { post } = Astro.props;
const title = clip(displayTitle(post), 60);
const desc = summary(post);
const cover = post.photos[0] ?? post.repost?.photos[0];
const ogImage = cover
    ? new URL(mediaUrl(cover.preview?.file ?? cover.file), `${siteUrl()}/`).href
    : undefined;

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        headline: displayTitle(post),
        description: desc,
        datePublished: post.date,
        dateModified: post.edited_date ?? post.date,
        author: {
            "@type": "Organization",
            name: "Республиканский центр коррекционной педагогики «Добромир»",
        },
        publisher: {
            "@type": "Organization",
            name: "Республиканский центр коррекционной педагогики «Добромир»",
            url: siteUrl(),
        },
        url: new URL(`/news/${post.slug}/`, `${siteUrl()}/`).href,
        ...(ogImage ? { image: ogImage } : {}),
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Главная",
                item: `${siteUrl()}/`,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "Новости",
                item: `${siteUrl()}/news/`,
            },
            { "@type": "ListItem", position: 3, name: displayTitle(post) },
        ],
    },
];
---

<Base
    title={title}
    description={desc}
    type="article"
    ogImage={ogImage}
    jsonLd={jsonLd}
>
    <div class="container page">
        <Breadcrumbs
            items={[
                { href: "/", label: "Главная" },
                { href: "/news/", label: "Новости" },
            ]}
        />
        <PostArticle post={post} />
    </div>
</Base>

<style>
    .page {
        max-width: 48rem;
        padding-block: var(--space-6) var(--space-7);
    }
</style>
