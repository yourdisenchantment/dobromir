---
// Страница новости. Удаленного поста в news.json нет - страница не собирается, адрес дает 404.
// Ее же часть (PostArticle, data-modal-content) показывает всплывающее окно на лендинге.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostArticle from "../../components/PostArticle.astro";
import { clip } from "../../lib/cardtext";
import { displayTitle, loadNews, summary, type NewsPost } from "../../lib/news";

export function getStaticPaths() {
    return loadNews().map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: NewsPost;
}

const { post } = Astro.props;
---

<Base
    title={clip(displayTitle(post), 60)}
    description={summary(post)}
    type="article"
>
    <div class="container page">
        <Breadcrumbs
            items={[
                { href: "/", label: "Главная" },
                { href: "/news/", label: "Новости" },
            ]}
        />
        <PostArticle post={post} />
    </div>
</Base>

<style>
    .page {
        max-width: 48rem;
        padding-block: var(--space-6) var(--space-7);
    }
</style>
