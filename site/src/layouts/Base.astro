---
// Общая обертка страницы: язык, заголовок, описание, canonical, запрет индексации для
// тестовой копии, подтверждение прав для поисковиков. Без стилей и дизайна (это P3).
import { siteEnv, siteUrl, verification } from "../lib/env";

interface Props {
    title: string;
    description: string;
    type?: "website" | "article";
}

const { title, description, type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, `${siteUrl()}/`).href;
const staging = siteEnv() === "staging";
const { yandex, google } = verification();
const fullTitle = title === "Добромир" ? title : `${title} - Добромир`;
---

<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {staging && <meta name="robots" content="noindex, nofollow" />}
        {yandex && <meta name="yandex-verification" content={yandex} />}
        {google && <meta name="google-site-verification" content={google} />}
        <meta property="og:type" content={type} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content="ru_RU" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Новости Добромира"
            href="/rss.xml"
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>
    <body>
        <header>
            <nav aria-label="Основное меню">
                <a href="/">Добромир</a>
                <a href="/news/">Новости</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
    </body>
</html>
