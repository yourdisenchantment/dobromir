---
// Общая обертка страницы: язык, заголовок, описание, canonical, запрет индексации для
// тестовой копии, подтверждение прав для поисковиков; стили дизайна (утвержден по
// стайлбуку 2026-10-26), шапка, подвал, кнопка «Наверх» и всплывающее окно карточек.
import "../styles/base.css";
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/post.css";
import Modal from "../components/Modal.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ToTop from "../components/ToTop.astro";
import { siteEnv, siteUrl, verification } from "../lib/env";

interface Props {
    title: string;
    description: string;
    type?: "website" | "article";
    /** Страница не для поисковиков (404): без canonical, с noindex. */
    noindex?: boolean;
    /** Абсолютный или относительный URL картинки для og:image и Twitter. */
    ogImage?: string;
    /** JSON-LD объекты для поисковиков (Organization, Person, NewsArticle, BreadcrumbList). */
    jsonLd?: Record<string, unknown>[];
}

const {
    title,
    description,
    type = "website",
    noindex = false,
    ogImage,
    jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, `${siteUrl()}/`).href;
const staging = siteEnv() === "staging";
const { yandex, google } = verification();
const fullTitle = title === "Добромир" ? title : `${title} - Добромир`;
---

<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        {!noindex && <link rel="canonical" href={canonical} />}
        {(staging || noindex) && (
            <meta name="robots" content="noindex, nofollow" />
        )}
        {yandex && <meta name="yandex-verification" content={yandex} />}
        {google && <meta name="google-site-verification" content={google} />}
        <meta property="og:type" content={type} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {!noindex && <meta property="og:url" content={canonical} />}
        <meta property="og:locale" content="ru_RU" />
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage && <meta name="twitter:card" content="summary_large_image" />}
        {ogImage && <meta name="twitter:image" content={ogImage} />}
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Новости Добромира"
            href="/rss.xml"
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
        {jsonLd &&
            jsonLd.map((item) => (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(item)}
                />
            ))}
    </head>
    <body>
        <a class="skip-link" href="#main">
            Перейти к содержанию
        </a>
        <SiteHeader />
        <main id="main">
            <slot />
        </main>
        <SiteFooter />
        <ToTop />
        <Modal />
    </body>
</html>
