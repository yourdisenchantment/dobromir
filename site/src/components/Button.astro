---
// Кнопка или ссылка-кнопка. На экране одна основная (primary); вторичная - контур,
// текстовая - для третьих действий. Высота не меньше 48px (методичка, 7.2).
interface Props {
    href?: string;
    variant?: "primary" | "secondary" | "text";
    type?: "button" | "submit";
}

const { href, variant = "primary", type = "button" } = Astro.props;
---

{href ? (
    <a class:list={["btn", variant]} href={href}>
        <slot />
    </a>
) : (
    <button class:list={["btn", variant]} type={type}>
        <slot />
    </button>
)}

<style>
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-height: 48px;
        padding: var(--space-3) var(--space-5);
        border-radius: var(--radius-pill);
        border: 2px solid transparent;
        font-weight: 600;
        line-height: 1.2;
        text-decoration: none;
        cursor: pointer;
        transition:
            background-color 150ms ease,
            color 150ms ease;
    }
    .primary,
    .primary:visited {
        background: var(--color-primary);
        color: var(--color-on-primary);
    }
    .primary:hover {
        background: var(--color-primary-hover);
    }
    .secondary,
    .secondary:visited {
        background: transparent;
        color: var(--color-primary);
        border-color: currentColor;
    }
    .secondary:hover {
        background: var(--color-surface-alt);
    }
    .text,
    .text:visited {
        min-height: 44px;
        padding-inline: var(--space-2);
        color: var(--color-link);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
</style>
