---
// Карточки «черепицей», как архив новостей (с 2026-10-27, было каруселью): заголовок,
// подзаголовок, текст и список пунктов. Без раскрытия: все содержимое видно сразу.
import Card from "../Card.astro";
import type { Block } from "../../lib/content";

interface Props {
    block: Extract<Block, { type: "cards" }>;
}

const { block } = Astro.props;
---

<div class="container">
    {block.intro && <p class="intro">{block.intro}</p>}
    <ul class="masonry">
        {block.items.map((item) => (
            <Card
                as="li"
                title={item.title}
                subtitle={item.subtitle}
                text={item.text}
            >
                {item.list && (
                    <ul class="points">
                        {item.list.map((point) => (
                            <li>{point}</li>
                        ))}
                    </ul>
                )}
            </Card>
        ))}
    </ul>
</div>

<style>
    .intro {
        margin-bottom: var(--space-5);
        max-width: var(--measure);
    }
    .points {
        padding-inline-start: var(--space-5);
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        display: grid;
        gap: var(--space-1);
    }
</style>
