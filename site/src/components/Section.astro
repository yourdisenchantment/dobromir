---
// Секция лендинга: заголовок, содержимое, чередование фона. У секции с фоном alt сверху
// волна - у каждой секции свои изгибы, посчитанные при сборке из ее имени (решено
// 2026-10-26, отступление от «единой формы» методички 7.5); SVG без JS.
import { WAVE_HEIGHT, WAVE_WIDTH, wavePath } from "../lib/wave";

interface Props {
    id?: string;
    title?: string;
    alt?: boolean;
}

const { id, title, alt = false } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
const wave = alt ? wavePath(id ?? title ?? "") : "";
---

<section
    id={id}
    class:list={["section", { alt }]}
    aria-labelledby={title ? headingId : undefined}
>
    {alt && (
        <svg
            class="wave"
            viewBox={`0 0 ${WAVE_WIDTH} ${WAVE_HEIGHT}`}
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
        >
            <path d={wave} />
        </svg>
    )}
    <div class="inner">
        {title && (
            <h2 id={headingId} class="container">
                {title}
            </h2>
        )}
        <slot />
    </div>
</section>

<style>
    .section {
        position: relative;
    }
    .inner {
        padding-block: var(--section-y);
    }
    .alt .inner {
        background: var(--color-surface-alt);
    }
    .wave {
        display: block;
        width: 100%;
        height: clamp(32px, 5vw, 80px);
        fill: var(--color-surface-alt);
    }
    h2 {
        margin-bottom: var(--space-6);
    }
</style>
