---
// Тело поста или оригинала репоста: текст, фото, ссылки, документы и видео.
// Документы и видео не храним - ведем на пост в VK (решено 2026-10-23). Оформление -
// общие классы post-* (styles/post.css): разметка показывается и во всплывающем окне.
import PostText from "./PostText.astro";
import { mediaUrl, type NewsPhoto } from "../lib/news";
import { safeHref } from "../lib/vktext";

interface Props {
    text: string;
    photos: NewsPhoto[];
    links: { url: string; title: string }[];
    media: { kind: "doc" | "video"; title: string }[];
    sourceUrl: string;
    alt: string;
}

const { text, photos, links, media, sourceUrl, alt } = Astro.props;
const kinds = { doc: "Документ", video: "Видео" };
// Ссылки-вложения из VK - только http(s), как ссылки в тексте: адрес вида javascript:
// в href - это XSS (найдено при обзоре 2026-10-27). Неподходящая ссылка - просто текст.
const safeLinks = links.map((l) => ({ ...l, href: safeHref(l.url) }));
---

{text && (
    <div class="post-text">
        <PostText text={text} />
    </div>
)}
{photos.length > 0 && (
    <div class="post-photos">
        {photos.map((p, i) => (
            <img
                src={mediaUrl(p.file)}
                width={p.width}
                height={p.height}
                alt={photos.length > 1 ? `${alt}, фото ${i + 1}` : alt}
                loading="lazy"
                decoding="async"
            />
        ))}
    </div>
)}
{(links.length > 0 || media.length > 0) && (
    <ul class="post-links">
        {safeLinks.map((l) => (
            <li>
                {l.href ? (
                    <a href={l.href} rel="nofollow noopener">
                        {l.title || l.url}
                    </a>
                ) : (
                    l.title || l.url
                )}
            </li>
        ))}
        {media.map((m) => (
            <li>
                <a href={sourceUrl} rel="nofollow noopener">
                    {kinds[m.kind]}
                    {m.title ? `: ${m.title}` : ""} - смотреть в VK
                </a>
            </li>
        ))}
    </ul>
)}
