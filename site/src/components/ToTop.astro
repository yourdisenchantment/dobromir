---
// Кнопка «Наверх» на всех страницах (2026-10-27): появляется, когда прокрутили больше
// экрана. Без JS ее нет (атрибут hidden).
// С клавиатуры фокус уходит на ссылку «Перейти к содержанию» - продолжать с начала.
import Icon from "./Icon.astro";
---

<a class="to-top" href="#main" data-to-top hidden aria-label="Наверх">
    <Icon name="arrow_upward" class="icon" />
</a>

<script>
    const button = document.querySelector<HTMLAnchorElement>("[data-to-top]");
    if (button) {
        button.hidden = false;
        let ticking = false;
        const update = () => {
            button.classList.toggle(
                "shown",
                window.scrollY > window.innerHeight,
            );
            ticking = false;
        };
        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    ticking = true;
                    requestAnimationFrame(update);
                }
            },
            { passive: true },
        );
        update();
        button.addEventListener("click", (event) => {
            event.preventDefault();
            const reduce = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
            // detail 0 - нажали Enter, а не кликнули мышью или пальцем
            if (event.detail === 0) {
                document
                    .querySelector<HTMLElement>(".skip-link")
                    ?.focus({ preventScroll: true });
            }
        });
    }
</script>

<style>
    .to-top {
        position: fixed;
        inset-inline-end: max(var(--space-4), env(safe-area-inset-right));
        inset-block-end: max(var(--space-4), env(safe-area-inset-bottom));
        z-index: 15;
        display: grid;
        place-items: center;
        inline-size: 3rem;
        block-size: 3rem;
        border-radius: 50%;
        background: var(--color-surface);
        color: var(--color-primary);
        border: 2px solid var(--color-primary);
        box-shadow: var(--shadow-1);
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.5rem);
        transition:
            opacity 150ms ease,
            transform 150ms ease,
            visibility 150ms;
    }
    .to-top[hidden] {
        display: none;
    }
    .to-top.shown {
        opacity: 1;
        visibility: visible;
        transform: none;
    }
    .to-top:hover {
        background: var(--color-primary);
        color: var(--color-on-primary);
    }
    .to-top :global(.icon) {
        inline-size: 1.5rem;
        block-size: 1.5rem;
    }
</style>
