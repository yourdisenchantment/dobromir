---
// Шапка: логотип, меню (переходы к блокам лендинга), телефон для записи.
// Липкая (решено 2026-10-26): остается сверху при прокрутке; чтобы она не закрывала
// якоря и фокус (WCAG 2.4.11), высота шапки - --header-h, на нее же scroll-padding-top.
// Пункт текущего раздела подсвечивается маленьким скриптом; без JS подсветки нет, все
// остальное работает. На телефоне меню и телефон спрятаны в <details> (методичка 7.3).
// Ссылки повторены в двух навигациях, но видна всегда одна: вторая скрыта display: none
// и для экранных дикторов.
import { menuLinks, siteContacts, tel } from "../lib/content";

interface Props {
    /** Начало ссылок меню: "/" на всех страницах, "" - на самом лендинге-образце. */
    base?: string;
}

const { base = "/" } = Astro.props;
// Пункты меню - блоки лендинга с полем menu, в порядке site/content/page.json
// (решено 2026-10-27): меню и блоки на странице идут в одном порядке.
const links = menuLinks().map((l) => ({ ...l, href: `${base}#${l.id}` }));
const { booking } = siteContacts();
const phone = { href: tel(booking.number), label: booking.number };
---

<header class="header" data-header>
    <div class="bar container">
        <a class="logo" href="/" aria-label="Добромир, на главную">
            <img src="/logo.svg" width="568" height="232" alt="" />
            <span class="name">Добромир</span>
        </a>
        <nav aria-label="Основное меню" class="nav wide">
            <ul>
                {links.map((l) => (
                    <li>
                        <a href={l.href} data-section={l.id}>
                            {l.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <a class="phone wide" href={phone.href}>
            {phone.label}
        </a>
        <details class="menu">
            <summary>Меню</summary>
            <nav aria-label="Основное меню" class="nav">
                <ul>
                    {links.map((l) => (
                        <li>
                            <a href={l.href} data-section={l.id}>
                                {l.label}
                            </a>
                        </li>
                    ))}
                </ul>
                <a class="phone" href={phone.href}>
                    {phone.label}
                </a>
            </nav>
        </details>
    </div>
</header>

<script>
    // Подсветка пункта меню текущего раздела и закрытие мобильного меню после выбора.
    // Раздел текущий, если пересекает полосу в верхней трети экрана (под шапкой).
    const header = document.querySelector<HTMLElement>("[data-header]");
    if (header) {
        const links = [
            ...header.querySelectorAll<HTMLAnchorElement>("a[data-section]"),
        ];
        const sections = [...new Set(links.map((a) => a.dataset.section))]
            .map((id) => (id ? document.getElementById(id) : null))
            .filter((el): el is HTMLElement => el !== null)
            // в порядке на странице, а не в порядке пунктов меню
            .sort((a, b) =>
                a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING
                    ? -1
                    : 1,
            );
        const mark = (id: string | null) => {
            for (const a of links) {
                if (a.dataset.section === id)
                    a.setAttribute("aria-current", "location");
                else a.removeAttribute("aria-current");
            }
        };
        if (sections.length > 0) {
            const visible = new Set<string>();
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const e of entries) {
                        if (e.isIntersecting) visible.add(e.target.id);
                        else visible.delete(e.target.id);
                    }
                    // В полосе может оказаться граница двух разделов - берем верхний.
                    const first = sections.find((s) => visible.has(s.id));
                    mark(first ? first.id : null);
                },
                { rootMargin: "-20% 0px -70% 0px" },
            );
            for (const s of sections) observer.observe(s);
        }
        const menu = header.querySelector<HTMLDetailsElement>("details");
        for (const a of menu?.querySelectorAll("a") ?? []) {
            a.addEventListener("click", () => menu?.removeAttribute("open"));
        }
    }
</script>

<style>
    .header {
        position: sticky;
        top: 0;
        z-index: 20;
        min-height: var(--header-h);
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
    }
    .bar {
        /* шире основного контейнера: восемь пунктов меню, логотип и телефон в одну строку */
        width: min(100% - 2 * var(--gutter), var(--container-wide));
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3) var(--space-6);
        padding-block: var(--space-3);
    }
    .logo,
    .logo:visited {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        color: var(--color-text);
        text-decoration: none;
        margin-inline-end: auto;
    }
    .logo img {
        height: 36px;
        width: auto;
    }
    .name {
        font-weight: 750;
        font-size: 1.125rem;
        letter-spacing: -0.01em;
    }
    .nav ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-4);
    }
    .nav a,
    .nav a:visited {
        color: var(--color-text);
        text-decoration: none;
        font-weight: 500;
        padding-block: var(--space-2);
        display: inline-block;
    }
    .nav a:hover {
        color: var(--color-primary);
        text-decoration: underline;
    }
    /* Текущий раздел: цвет и черта снизу - не только цвет (методичка 6, 7.3) */
    .nav a[aria-current] {
        color: var(--color-primary);
        box-shadow: inset 0 -3px 0 var(--color-primary);
    }
    .phone,
    .phone:visited {
        font-weight: 650;
        color: var(--color-primary);
        text-decoration: none;
        white-space: nowrap;
    }
    .phone:hover {
        text-decoration: underline;
    }

    /* Телефон: меню свернуто в «Меню» */
    .wide {
        display: none;
    }
    .menu summary {
        list-style: none;
        cursor: pointer;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        border: 2px solid var(--color-border);
        border-radius: var(--radius-pill);
        font-weight: 600;
    }
    .menu summary::-webkit-details-marker {
        display: none;
    }
    .menu summary::before {
        content: "\2261"; /* ≡ */
        font-size: 1.25rem;
        line-height: 1;
    }
    .menu[open] summary::before {
        content: "\00d7"; /* × */
    }
    /* Открытое меню - панель на всю ширину под шапкой; кнопка остается на месте */
    .menu[open] .nav {
        position: absolute;
        inset-inline: 0;
        top: 100%;
        z-index: 5;
        padding: var(--space-3) var(--gutter) var(--space-5);
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        box-shadow: var(--shadow-1);
    }
    .menu .nav ul {
        flex-direction: column;
        gap: 0;
    }
    .menu .nav a {
        display: block;
        padding-block: var(--space-3);
        border-bottom: 1px solid var(--color-border);
    }
    .menu .phone {
        display: inline-block;
        margin-top: var(--space-4);
        font-size: var(--text-lead);
    }

    /* Широкий экран: меню в строку, телефон справа. Порог - по ширине восьми пунктов
       (2026-10-27); уже - кнопка «Меню», как на телефоне. */
    @media (min-width: 80rem) {
        .logo img {
            height: 44px;
        }
        .name {
            font-size: 1.25rem;
        }
        .wide {
            display: block;
        }
        .menu {
            display: none;
        }
    }
</style>
