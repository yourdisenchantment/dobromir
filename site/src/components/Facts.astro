---
// Цифры по образцу старого сайта (2026-10-27): иконка в круге, крупная цифра или
// заголовок, подпись; слева - полоса цвета слона. 2 в ряд на телефоне и планшете,
// 4 - на широком экране. У статистики - источник (методичка 7.6);
// у цифр самого центра источник не нужен.
import Icon from "./Icon.astro";

interface Fact {
    icon?: string;
    value: string;
    label: string;
    source?: { title: string; url?: string };
}
interface Props {
    items: Fact[];
}

const { items } = Astro.props;
---

<div class="container">
    <dl class="facts">
        {items.map((f) => (
            <div class="fact">
                <dt>
                    {f.icon && (
                        <span class="badge">
                            <Icon name={f.icon} class="icon" />
                        </span>
                    )}
                    {f.value}
                </dt>
                <dd>
                    {f.label}
                    {f.source && (
                        <small class="source">
                            {f.source.url ? (
                                <a href={f.source.url}>{f.source.title}</a>
                            ) : (
                                f.source.title
                            )}
                        </small>
                    )}
                </dd>
            </div>
        ))}
    </dl>
</div>

<style>
    .facts {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-6) var(--space-4);
        padding-inline-start: var(--space-4);
        border-inline-start: 4px solid var(--color-accent);
    }
    @media (min-width: 64rem) {
        .facts {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    .fact {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    /* Значок внутри dt: в dl у div могут быть только dt и dd */
    .badge {
        display: grid;
        place-items: center;
        inline-size: 4.5rem;
        block-size: 4.5rem;
        margin-bottom: var(--space-4);
        border-radius: 50%;
        background: var(--color-surface);
        box-shadow: var(--shadow-1);
        color: var(--color-accent);
    }
    .badge :global(.icon) {
        inline-size: 2.75rem;
        block-size: 2.75rem;
    }
    dt {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: var(--text-h3);
        font-weight: 750;
        color: var(--color-text);
        line-height: 1.15;
    }
    dd {
        margin-top: var(--space-2);
        max-width: 22ch;
        color: var(--color-text-muted);
    }
    .source {
        display: block;
        margin-top: var(--space-1);
        font-size: var(--text-sm);
    }
</style>
