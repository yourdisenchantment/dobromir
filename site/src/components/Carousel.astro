---
// Карусель: карточки в одну строку (решено 2026-10-25). Первая (самая свежая) - по
// центру, слева от нее пусто, следующие уходят за правый край. Листается свайпом и
// колесом без JS; кнопки со стрелками появляются, только если работает скрипт. Ничего
// не крутится само. С клавиатуры ряд листается сам: Tab переходит по ссылкам карточек,
// браузер прокручивает к ним. Дети - карточки с as="li".
interface Props {
    label: string;
}

const { label } = Astro.props;
---

<div class="carousel" data-carousel>
    <ul class="track" aria-label={label}>
        <slot />
    </ul>
    <div class="controls container" data-controls hidden>
        <button type="button" data-step="-1" aria-label="Предыдущие">
            <span aria-hidden="true">←</span>
        </button>
        <button type="button" data-step="1" aria-label="Следующие">
            <span aria-hidden="true">→</span>
        </button>
    </div>
</div>

<script>
    // Кнопки «назад/вперед»: прокрутка на одну карточку. Скрипт только добавляет удобство:
    // без него ряд листается пальцем и колесом, а кнопок просто не видно.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const scrollAnimation = CSS.supports("animation-timeline: view()");
    for (const root of document.querySelectorAll<HTMLElement>(
        "[data-carousel]",
    )) {
        const track = root.querySelector<HTMLElement>(".track");
        const controls = root.querySelector<HTMLElement>("[data-controls]");
        if (!track || !controls) continue;
        const buttons = [
            ...controls.querySelectorAll<HTMLButtonElement>("button"),
        ];
        const step = () => {
            const card = track.firstElementChild as HTMLElement | null;
            const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
            return card ? card.offsetWidth + gap : track.clientWidth;
        };
        const update = () => {
            const max = track.scrollWidth - track.clientWidth - 1;
            buttons[0].disabled = track.scrollLeft <= 1;
            buttons[1].disabled = track.scrollLeft >= max;
        };
        for (const button of buttons) {
            button.addEventListener("click", () => {
                const dir = Number(button.dataset.step);
                track.scrollBy({
                    left: dir * step(),
                    behavior: reduce.matches ? "auto" : "smooth",
                });
            });
        }
        track.addEventListener("scroll", update, { passive: true });
        controls.hidden = false;
        update();
        if (!scrollAnimation && !reduce.matches) focusByScript(track);
    }

    // Где нет анимации от прокрутки (Firefox, 2026-10-28) - то же выделение центральной
    // карточки скриптом, по тем же числам, что @keyframes carousel-focus ниже: в пределах
    // 10% пути карточки через ряд (40-60% диапазона cover) - от 1.06 к 0.85 и от 1 к 0.5.
    function focusByScript(track: HTMLElement) {
        let frame = 0;
        const paint = () => {
            frame = 0;
            const box = track.getBoundingClientRect();
            const center = box.left + box.width / 2;
            for (const item of track.children as HTMLCollectionOf<HTMLElement>) {
                if (item.matches(":focus-within")) {
                    item.style.opacity =
                        item.style.scale =
                        item.style.translate =
                            "";
                    continue;
                }
                const r = item.getBoundingClientRect();
                const offset = r.left + r.width / 2 - center;
                const t = Math.min(
                    Math.abs(offset) / (0.1 * (box.width + r.width)),
                    1,
                );
                item.style.opacity = String(1 - 0.5 * t);
                item.style.scale = String(1.06 - 0.21 * t);
                item.style.translate = `${-Math.sign(offset) * 4.5 * t}% 0`;
            }
        };
        const schedule = () => {
            frame ||= requestAnimationFrame(paint);
        };
        track.addEventListener("scroll", schedule, { passive: true });
        track.addEventListener("focusin", schedule);
        track.addEventListener("focusout", schedule);
        window.addEventListener("resize", schedule);
        paint();
    }
</script>

<style>
    .track {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: var(--space-5);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        /* карточки своей высоты, по средней линии ряда (решено 2026-10-27, все карусели) */
        align-items: center;
        scroll-behavior: smooth;
        /* Первая и последняя карточки встают по центру: слева от свежей - пусто */
        padding-inline: max(var(--gutter), calc(50% - var(--card-w) / 2));
        /* место сверху и снизу: увеличенная карточка не должна обрезаться краем ряда */
        padding-block: var(--space-5);
        scrollbar-width: thin;
        scrollbar-color: var(--color-border) transparent;
    }
    .track > :global(*) {
        flex: 0 0 var(--card-w);
        scroll-snap-align: center;
        max-width: none;
    }
    /* Текущая карточка (по центру) - яркая и крупнее, соседние меньше и тусклее
       (решено 2026-10-27). Анимация от прокрутки, без JS; где браузер ее не умеет
       (Firefox) - то же скриптом выше, без скрипта карточки одинаковые. Карточка с фокусом клавиатуры - всегда яркая. При «уменьшить
       движение» анимацию выключает общее правило base.css - карточки тоже одинаковые. */
    @supports (animation-timeline: view()) {
        .track > :global(*) {
            animation: carousel-focus linear both;
            animation-timeline: view(inline);
            animation-range: cover;
        }
        .track > :global(*:focus-within) {
            animation: none;
        }
        /* Уменьшенные соседи придвинуты к центральной карточке (translate), чтобы между
           ними не оставалось пустого места от уменьшения: справа - влево, слева - вправо. */
        @keyframes carousel-focus {
            0%,
            40% {
                opacity: 0.5;
                scale: 0.85;
                translate: -4.5% 0;
            }
            50% {
                opacity: 1;
                scale: 1.06;
                translate: 0 0;
            }
            60%,
            100% {
                opacity: 0.5;
                scale: 0.85;
                translate: 4.5% 0;
            }
        }
    }
    .controls {
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        margin-top: var(--space-4);
    }
    .controls[hidden] {
        display: none;
    }
    .controls button {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-pill);
        border: 2px solid var(--color-primary);
        background: var(--color-surface);
        color: var(--color-primary);
        font-size: 1.25rem;
        cursor: pointer;
    }
    .controls button:hover:not(:disabled) {
        background: var(--color-surface-alt);
    }
    .controls button:disabled {
        opacity: 0.4;
        cursor: default;
    }
</style>
